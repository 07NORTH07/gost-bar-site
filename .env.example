# Скопіюй цей файл у .env і заповни. Сам .env у git не потрапляє (див. .gitignore).
# Node.js не читає .env автоматично — запускай через:  npm run start:env

# Порт сервера (за замовчуванням 3000)
PORT=3000

# Пароль входу в адмінку /admin/. Якщо не задати — на кожному запуску
# генерується випадковий і друкується в консоль.
ADMIN_PASSWORD=придумай-довгий-унікальний-пароль

# Якщо сайт стоїть за reverse-proxy (Render, nginx) — розкоментуй,
# інакше ліміти запитів рахуватимуться на всіх користувачів разом.
# На Render вмикається сам. Локально НЕ ставити.
# TRUST_PROXY=1
