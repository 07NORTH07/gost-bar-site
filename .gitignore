# --- Залежності ---
node_modules/

# --- База даних: у ній замовлення клієнтів (імена, телефони, адреси). НЕ комітити! ---
# Нова БД створюється командою `npm run seed`.
server/database/*.db
server/database/*.db-*
*.sqlite
*.sqlite3

# --- Фото, завантажені через адмінку ---
uploads/

# --- Секрети та локальні налаштування ---
.env
.env.*
!.env.example

# --- Особисті нотатки (напр. домашня IP-адреса, паролі) ---
guide.txt
notes.txt
*.local.txt

# --- Системне та редактори ---
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
